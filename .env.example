# --- VLM inference server (OpenAI-compatible /v1/chat/completions) ---
# In-cluster example:
#   VLM_ENDPOINT=http://vlm-service.default.svc.cluster.local:8000
# Public / Envoy gateway example:
#   VLM_ENDPOINT=https://vlm.example.com
VLM_ENDPOINT=http://localhost:8000
VLM_CHAT_PATH=/v1/chat/completions
VLM_MODEL=Qwen/Qwen2-VL-7B-Instruct
# Bearer token if the gateway requires auth (leave blank for none).
VLM_API_KEY=
VLM_TIMEOUT=60

# --- Frame sampling ---
FRAME_INTERVAL=2.0
JPEG_QUALITY=80
MAX_FRAME_EDGE=1024

# --- Web server ---
HOST=0.0.0.0
PORT=8080
