# Every value here is injected by the llm-d router's gateway hook when it
# provisions the handler. This file is only for running the worker by hand.

# --- Required: injected per session ---
# Correlates frame submissions with the session the caller started.
SESSION_ID=local-dev
# The cellphone camera address the user typed into the UI.
#   MJPEG: http://<phone-ip>:4747/video
#   RTSP:  rtsp://<phone-ip>:4747/
STREAM_URL=http://192.168.1.42:4747/video
# The inference pool endpoint llm-d assigned this session to.
POOL_ENDPOINT=http://vlm-service.default.svc.cluster.local:8000
# Where each frame's model output is POSTed so it reaches whoever started the
# session -- already session-scoped, the hook appended the session id. Leave it
# empty and the output is drained and dropped, which is only useful for load
# tests: nothing reaches the browser.
RESULTS_CALLBACK_URL=http://127.0.0.1:8080/ingest/local-dev

# --- Pool request shape ---
POOL_CHAT_PATH=/v1/chat/completions
MODEL=Qwen/Qwen2-VL-7B-Instruct
API_KEY=
TIMEOUT=60
PROMPT=Describe what you see in this image.

# --- Frame sampling ---
FRAME_INTERVAL=2.0
JPEG_QUALITY=80
MAX_FRAME_EDGE=1024
STREAM_OPEN_TIMEOUT=15

# --- Backstops (the only thing that stops an orphaned handler) ---
MAX_SESSION_SECONDS=300
MAX_FRAMES=0
IDLE_TIMEOUT=30
