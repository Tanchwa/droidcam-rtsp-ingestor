# The frontend only talks to the llm-d router gateway. It has no VLM endpoint,
# no pool address, and no knowledge of the handler.

# --- llm-d router gateway ---
# In-cluster example:
#   GATEWAY_ENDPOINT=http://llm-d-inference-gateway.llm-d.svc.cluster.local:80
# Public / Envoy gateway example:
#   GATEWAY_ENDPOINT=https://llm-d.example.com
GATEWAY_ENDPOINT=http://localhost:8000
GATEWAY_CHAT_PATH=/v1/chat/completions
MODEL=Qwen/Qwen2-VL-7B-Instruct
# Bearer token if the gateway requires auth (leave blank for none).
API_KEY=
# How long the token response to our POST may stay open. This is the gateway
# response only -- the frontend never opens the cellphone camera stream itself. Keep it
# comfortably above the handler's MAX_SESSION_SECONDS.
RESPONSE_TIMEOUT=60
# Where the handler should POST results. In Kubernetes this is derived from
# POD_IP; set it explicitly when running outside a cluster (a tunnel, say).
# RESULTS_CALLBACK_BASE=http://192.168.1.10:8080/ingest

# --- UI defaults (the browser can override both) ---
PROMPT=Describe what you see in this image.
FRAME_INTERVAL=2.0

# --- Web server ---
HOST=0.0.0.0
PORT=8080
